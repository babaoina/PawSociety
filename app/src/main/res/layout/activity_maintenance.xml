<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="30dp"
    android:background="@drawable/maintenance_gradient_bg">

    <!-- Animated Paw Icon -->
    <FrameLayout
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginBottom="20dp">

        <!-- Background Circle -->
        <View
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:background="@drawable/circle_solid_highlight"
            android:backgroundTint="#7A4F2B"
            android:alpha="0.1"/>

        <!-- Maintenance Icon -->
        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:src="@drawable/maintenance_icon"
            android:tint="#7A4F2B"/>

        <!-- Small Paw Prints -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:text="🐾"
            android:textSize="30sp"
            android:rotation="15"
            android:alpha="0.5"/>
    </FrameLayout>

    <!-- Title with Shadow -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Under Maintenance"
        android:textSize="32sp"
        android:textColor="#7A4F2B"
        android:textStyle="bold"
        android:shadowColor="#807A4F2B"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:layout_marginBottom="8dp"/>

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="We're making things better!"
        android:textSize="16sp"
        android:textColor="#B88B4A"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="24dp"/>

    <!-- Message Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:elevation="4dp"
        android:padding="24dp"
        android:layout_marginVertical="20dp"
        android:gravity="center">

        <TextView
            android:id="@+id/tv_maintenance_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PawSociety is under maintenance. We'll be back soon! 🐾"
            android:textSize="16sp"
            android:textColor="#666666"
            android:gravity="center"
            android:lineSpacingExtra="4dp"/>

        <!-- Decorative Line -->
        <View
            android:layout_width="60dp"
            android:layout_height="2dp"
            android:background="#FAE9DC"
            android:layout_marginTop="16dp"/>
    </LinearLayout>

    <!-- Progress Bar (Indeterminate) -->
    <ProgressBar
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminateTint="#7A4F2B"
        android:layout_marginBottom="30dp"/>

    <!-- Buttons Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp">

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="TRY AGAIN"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/maintenance_button_bg"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btn_contact_support"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CONTACT SUPPORT"
            android:textColor="#7A4F2B"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/maintenance_button_outline"/>
    </LinearLayout>

    <!-- Footer Text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🐾 PawSociety Team"
        android:textSize="12sp"
        android:textColor="#B88B4A"
        android:layout_marginTop="24dp"
        android:alpha="0.7"/>

</LinearLayout>