<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER with Profile Picture -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <!-- Profile Image (for users with actual image) -->
            <ImageView
                android:id="@+id/post_profile_image"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:background="@drawable/circle_border" />

            <!-- Profile Icon (text fallback) -->
            <TextView
                android:id="@+id/post_profile_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:text="M"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/circle_solid_profile"
                android:visibility="visible" />

            <!-- Profile Image OR Icon container - both use same ID for positioning -->
            <View
                android:id="@+id/profile_anchor"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:visibility="invisible" />

            <!-- Username and Location - Always positioned relative to profile_anchor -->
            <LinearLayout
                android:id="@+id/user_info_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/profile_anchor"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/post_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Floyd Miles"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/post_user_role"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pet Owner"
                    android:textColor="#7A4F2B"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Time - Now before 3 dots -->
            <TextView
                android:id="@+id/post_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/btn_more"
                android:layout_centerVertical="true"
                android:text="2h"
                android:textColor="#999999"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

            <!-- Three Dots -->
            <ImageView
                android:id="@+id/btn_more"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_more_vert"
                android:tint="#999999"
                android:background="?android:attr/selectableItemBackgroundBorderless" />

        </RelativeLayout>

        <!-- IMAGE -->
        <FrameLayout
            android:id="@+id/image_carousel_container"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="#F5F5F5">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/post_view_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/post_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="visible" />

            <!-- Status Badge -->
            <TextView
                android:id="@+id/post_status"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_margin="12dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="LOST"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/status_badge_lost" />

            <!-- Reward Badge (on image for Lost posts) -->
            <TextView
                android:id="@+id/post_reward_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="12dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="💰 ₱ 1,000,000"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/reward_badge_background"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/indicator_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/no_image_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="#F0F0F0">

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:gravity="center"
                    android:text="🐾"
                    android:textSize="40sp"
                    android:textColor="#CCCCCC" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No image"
                    android:textColor="#999999"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

        </FrameLayout>

        <!-- PET INFO + ACTION BUTTONS (SIDE BY SIDE) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <!-- Left side - Pet Info -->
            <LinearLayout
                android:id="@+id/pet_info_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/action_buttons_container"
                android:orientation="vertical"
                android:layout_marginEnd="16dp">

                <!-- 🔥 FIXED: Breed and Badge in a horizontal layout - BADGE STAYS WITH BREED -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/post_pet_type"
                        android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:text="Chihuahua"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                    <!-- Category Badge - RIGHT NEXT to breed with minimal gap -->
                    <TextView
                        android:id="@+id/post_category_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:layout_marginStart="8dp"
                    android:text="DOG"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/category_badge_rounded"
                    android:visibility="gone" />
                </LinearLayout>

                <!-- Pet Name - Below breed -->
                <TextView
                    android:id="@+id/post_pet_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Milo"
                    android:textColor="#7A4F2B"
                    android:textSize="18sp"
                    android:layout_marginBottom="12dp" />

                <!-- Gender, Age, Weight Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <!-- Gender Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginEnd="1dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GENDER"
                            android:textColor="#7A4F2B"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="2dp" />

                        <TextView
                            android:id="@+id/post_gender_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Male"
                            android:textColor="#666666"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/post_gender_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Age Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginEnd="1dp"
                        android:layout_marginStart="1dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AGE"
                            android:textColor="#7A4F2B"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="2dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/post_age"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="8 months"
                                android:textColor="#666666"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Weight Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginStart="1dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WEIGHT"
                            android:textColor="#7A4F2B"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="2dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/post_weight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3.5kg"
                                android:textColor="#666666"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- REWARD SECTION - SIMPLE DISPLAY LIKE NUMBER -->
                <LinearLayout
                    android:id="@+id/reward_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/rounded_highlight_gold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/post_reward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱1,000,000"
                    android:textColor="#B8860B"
                android:textSize="14sp"
                android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REWARD"
                    android:textColor="#B8860B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

                <!-- Contact Number - Simple display with green highlight -->
                <LinearLayout
                    android:id="@+id/btn_call_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/rounded_highlight_green"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                    android:layout_marginTop="0dp"
                    android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_call_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/phone"
                    android:tint="#4CAF50"
                android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/post_contact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09678768888"
                    android:textColor="#4CAF50"
                android:textSize="14sp"
                android:textStyle="bold" />
            </LinearLayout>

                <!-- Location with emoji - MOVED ABOVE About -->
                <TextView
                    android:id="@+id/post_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 San Carlos, Pangasinan"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/post_case_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_create_post_category"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp"
                    android:text="Lost Pet • Last seen Mar 21, 2026 • Call preferred"
                    android:textColor="#7A4F2B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/post_case_details_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_create_post_card"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Case Details"
                        android:textColor="#7A4F2B"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/post_case_detail_primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Scenario: Lost Pet"
                        android:textColor="#3C3128"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/post_case_detail_secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Details: In my care • Call preferred"
                        android:textColor="#6B5A49"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/post_case_detail_tertiary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Note: Brown collar"
                        android:textColor="#6B5A49"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- About Section Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About"
                    android:textColor="#7A4F2B"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp" />

                <!-- Description Container with "more" button -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/post_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dogs are among the most trusted and loving companions in the world. They communicate through actions, experiences and endless loyalty. Every dog has its own personality."
                        android:textColor="#666666"
                        android:textSize="14sp"
                        android:lineSpacingExtra="2dp"
                        android:maxLines="4"
                        android:ellipsize="end" />
                </FrameLayout>

                <!-- "more" button - appears when description is long -->
                <TextView
                    android:id="@+id/btn_more_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="more"
                    android:textColor="#7A4F2B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp" />

            </LinearLayout>

            <!-- Right side - Action Buttons Vertical -->
            <LinearLayout
                android:id="@+id/action_buttons_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignTop="@id/pet_info_container"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Like Button -->
                <LinearLayout
                    android:id="@+id/btn_like_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="16dp">

                    <com.example.pawsociety.widget.LikeButton
                        android:id="@+id/btn_like_lottie_view"
                        android:layout_width="40dp"
                        android:layout_height="40dp" />

                    <TextView
                        android:id="@+id/tv_like_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="124"
                        android:textColor="#7A4F2B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Chat Button -->
                <LinearLayout
                    android:id="@+id/btn_message_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/btn_message"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/message"
                        android:tint="#7A4F2B" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chat"
                        android:textColor="#7A4F2B"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Share Button -->
                <LinearLayout
                    android:id="@+id/btn_share_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/btn_share"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/share"
                        android:tint="#7A4F2B" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Share"
                        android:textColor="#7A4F2B"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Save/Favorite Button -->
                <LinearLayout
                    android:id="@+id/btn_favorite_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/btn_favorite"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/faved"
                        android:tint="#7A4F2B" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Save"
                        android:textColor="#666666"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
