<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_post_menu_sheet"
    android:elevation="16dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center"
        android:orientation="vertical">

        <View
            android:layout_width="42dp"
            android:layout_height="5dp"
            android:background="@drawable/bg_post_menu_handle" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_post_menu_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/menu_avatar_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_post_menu_avatar"
                android:clipToOutline="true"
                android:contentDescription="Poster image"
                android:outlineProvider="background"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/menu_avatar_fallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_post_menu_avatar"
                android:gravity="center"
                android:text="🐾"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:visibility="visible" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/menu_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="username"
                android:textColor="#20170F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menu_post_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="pet_name • Lost"
                android:textColor="#7C6C5E"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_close"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="#A18973"
            android:textSize="18sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:maxHeight="420dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_post_menu_panel"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:id="@+id/option_add_favorites"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:id="@+id/iv_favorite_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/faved"
                    android:tint="#2B2118" />

                <TextView
                    android:id="@+id/tv_favorite_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="Add to favorites"
                    android:textColor="#2B2118"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/option_follow"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:id="@+id/iv_follow_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/add"
                    android:tint="#2B2118" />

                <TextView
                    android:id="@+id/tv_follow_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="Follow"
                    android:textColor="#2B2118"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/option_edit"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_edit_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/edit"
                    android:tint="#2B2118" />

                <TextView
                    android:id="@+id/tv_edit_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="Edit Post"
                    android:textColor="#2B2118"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/option_resolve"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_resolve_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_check"
                    android:tint="#2B2118" />

                <TextView
                    android:id="@+id/tv_resolve_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="Mark as Closed"
                    android:textColor="#2B2118"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/option_hide"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_eye_closed"
                    android:tint="#2B2118" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="Hide"
                    android:textColor="#2B2118"
                    android:textSize="16sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="18dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="6dp"
                android:background="#ECDDCB" />

            <LinearLayout
                android:id="@+id/option_block"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_block_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/block"
                    android:tint="#D64A3A" />

                <TextView
                    android:id="@+id/tv_block_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="Block User"
                    android:textColor="#D64A3A"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/option_report"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/report"
                    android:tint="#D64A3A" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="Report"
                    android:textColor="#D64A3A"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/option_delete"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/delete"
                    android:tint="#D64A3A" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="Delete Post"
                    android:textColor="#D64A3A"
                    android:textSize="16sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
