<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- ViewPager for images -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/gallery_view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000" />

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#80000000"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/btn_gallery_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/close"
            android:tint="#FFFFFF"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_gallery_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1/5"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical" />

        <ImageView
            android:id="@+id/btn_gallery_download"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/download"
            android:tint="#FFFFFF"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:contentDescription="Download" />

        <ImageView
            android:id="@+id/btn_gallery_share"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/share"
            android:tint="#FFFFFF"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:contentDescription="Share" />
    </LinearLayout>

    <!-- Bottom Tab Indicators -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/gallery_tab_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        app:tabBackground="@drawable/tab_selector_white"
        app:tabGravity="center"
        app:tabIndicatorHeight="0dp" />

</FrameLayout>