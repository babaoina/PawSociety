<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF"
    android:elevation="8dp">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✨ Create Highlight"
        android:textColor="#2C2C2C"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Highlight Cover Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Highlight Cover"
        android:textColor="#2C2C2C"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Circular Image Preview -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginBottom="20dp"
        android:background="#F5F5F5"
        android:gravity="center"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/circle_solid_white">

            <!-- Image Preview -->
            <ImageView
                android:id="@+id/highlight_image_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_image_placeholder"
                android:scaleType="centerCrop"
                android:contentDescription="Highlight cover" />

            <!-- Camera Icon Overlay -->
            <LinearLayout
                android:id="@+id/btn_select_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📷"
                    android:textSize="36sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to select"
                    android:textColor="#999999"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Highlight Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Highlight Name"
        android:textColor="#2C2C2C"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/et_highlight_name"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="e.g., My Dogs, Vacations, Adventures"
        android:textColorHint="#CCCCCC"
        android:padding="12dp"
        android:background="@drawable/input_oval"
        android:layout_marginBottom="20dp"
        android:textSize="14sp"
        android:textColor="#2C2C2C" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8E8E8"
        android:layout_marginBottom="20dp" />

    <!-- Choose from Posts -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Or choose from your posts"
        android:textColor="#666666"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"
        android:layout_gravity="center_horizontal" />

    <!-- Horizontal scroll of user's posts (CIRCULAR) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:scrollbars="none"
        android:layout_marginBottom="20dp"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/posts_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp" />
    </HorizontalScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="end"
        android:spacing="8dp">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:text="CANCEL"
            android:textColor="#999999"
            android:background="#E8E8E8"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_create"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:text="CREATE"
            android:textColor="#FFFFFF"
            android:background="#FF9800"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>