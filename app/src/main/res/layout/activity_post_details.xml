<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/back"
            android:tint="#000000"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Post Details"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FAF0E6">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== POST CARD ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- ===== HEADER with Profile Picture and Time + 3 Dots ===== -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp">

                        <!-- Profile Image -->
                        <ImageView
                            android:id="@+id/post_profile_image"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            android:background="@drawable/circle_border" />

                        <!-- Profile Icon -->
                        <TextView
                            android:id="@+id/post_profile_icon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:gravity="center"
                            android:text="M"
                            android:textSize="20sp"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/circle_solid_profile"
                            android:visibility="visible" />

                        <!-- Anchor -->
                        <View
                            android:id="@+id/profile_anchor"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:visibility="invisible" />

                        <!-- Username -->
                        <TextView
                            android:id="@+id/post_user_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@id/profile_anchor"
                            android:layout_marginStart="12dp"
                            android:text="Floyd Miles"
                            android:textColor="#000000"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_toLeftOf="@+id/time_options_container" />

                        <!-- Time and 3 dots container -->
                        <LinearLayout
                            android:id="@+id/time_options_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- Time -->
                            <TextView
                                android:id="@+id/post_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2h"
                                android:textColor="#999999"
                                android:textSize="11sp"
                                android:layout_marginEnd="8dp" />

                            <!-- Three dots menu -->
                            <ImageView
                                android:id="@+id/btn_more_details"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_more_vert"
                                android:tint="#666666"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- ===== IMAGE CAROUSEL ===== -->
                    <FrameLayout
                        android:id="@+id/image_carousel_container"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:background="#F5F5F5">

                        <androidx.viewpager2.widget.ViewPager2
                            android:id="@+id/post_view_pager"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/post_image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="visible" />

                        <!-- Status Badge -->
                        <TextView
                            android:id="@+id/post_status"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_margin="12dp"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:text="LOST"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/status_badge_lost" />

                        <!-- Reward Badge on Image -->
                        <TextView
                            android:id="@+id/post_reward_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_margin="12dp"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:text="💰 ₱ 1,000,000"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:background="@drawable/reward_badge_background"
                            android:visibility="gone" />

                        <!-- Image Indicators -->
                        <LinearLayout
                            android:id="@+id/indicator_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="8dp"
                            android:orientation="horizontal"
                            android:visibility="gone" />

                        <!-- Page Indicator -->
                        <TextView
                            android:id="@+id/page_indicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="16dp"
                            android:background="#80000000"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <!-- No Image Placeholder -->
                        <LinearLayout
                            android:id="@+id/no_image_placeholder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:background="#F0F0F0">

                            <TextView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:gravity="center"
                                android:text="🐾"
                                android:textSize="40sp"
                                android:textColor="#CCCCCC" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="No image"
                                android:textColor="#999999"
                                android:textSize="14sp"
                                android:layout_marginTop="8dp" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- ===== PET INFO + ACTION BUTTONS (SIDE BY SIDE) ===== -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="12dp">

                        <!-- LEFT SIDE - Pet Info -->
                        <LinearLayout
                            android:id="@+id/pet_info_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_toStartOf="@+id/action_buttons_container"
                            android:orientation="vertical"
                            android:layout_marginEnd="16dp">

                            <!-- Breed/Pet Type - Large -->
                            <TextView
                                android:id="@+id/post_pet_type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Golden Retriever"
                                android:textColor="#000000"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp" />

                            <!-- Pet Name -->
                            <TextView
                                android:id="@+id/post_pet_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Milo"
                                android:textColor="#666666"
                                android:textSize="18sp"
                                android:layout_marginBottom="12dp" />

                            <!-- Gender, Age, Weight Row - STACKED STYLE from item post -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="12dp">

                                <!-- Gender Column -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center_horizontal"
                                    android:layout_marginEnd="1dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="GENDER"
                                        android:textColor="#7A4F2B"
                                        android:textSize="10sp"
                                        android:textStyle="bold"
                                        android:layout_marginBottom="2dp" />

                                    <TextView
                                        android:id="@+id/post_gender_text"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Male"
                                        android:textColor="#666666"
                                        android:textSize="14sp" />

                                    <ImageView
                                        android:id="@+id/post_gender_icon"
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:visibility="gone" />
                                </LinearLayout>

                                <!-- Age Column -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center_horizontal"
                                    android:layout_marginEnd="1dp"
                                    android:layout_marginStart="1dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="AGE"
                                        android:textColor="#7A4F2B"
                                        android:textSize="10sp"
                                        android:textStyle="bold"
                                        android:layout_marginBottom="2dp" />

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:gravity="center">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="🎂"
                                            android:textSize="14sp"
                                            android:layout_marginEnd="4dp" />

                                        <TextView
                                            android:id="@+id/post_age"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="8 months"
                                            android:textColor="#666666"
                                            android:textSize="14sp" />
                                    </LinearLayout>
                                </LinearLayout>

                                <!-- Weight Column -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center_horizontal"
                                    android:layout_marginStart="1dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="WEIGHT"
                                        android:textColor="#7A4F2B"
                                        android:textSize="10sp"
                                        android:textStyle="bold"
                                        android:layout_marginBottom="2dp" />

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:gravity="center">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="⚖️"
                                            android:textSize="14sp"
                                            android:layout_marginEnd="4dp" />

                                        <TextView
                                            android:id="@+id/post_weight"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="3.5kg"
                                            android:textColor="#666666"
                                            android:textSize="14sp" />
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Reward Container (for Lost posts) - THINNER -->
                            <LinearLayout
                                android:id="@+id/reward_container"
                                android:layout_width="wrap_content"
                                android:layout_height="24dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="#FFF9E6"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="2dp"
                                android:layout_marginBottom="12dp"
                                android:visibility="gone"
                                android:layout_gravity="start">

                                <TextView
                                    android:id="@+id/post_reward"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1,000,000"
                                    android:textColor="#7A4F2B"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=" REWARD"
                                    android:textColor="#7A4F2B"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:layout_marginStart="2dp" />
                            </LinearLayout>

                            <!-- About Section -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="About"
                                android:textColor="#7A4F2B"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="8dp" />

                            <!-- Description -->
                            <TextView
                                android:id="@+id/post_description"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Dogs are among the most trusted and loving companions in the world. They communicate through actions, experiences and endless loyalty. Every dog has its own personality."
                                android:textColor="#666666"
                                android:textSize="14sp"
                                android:lineSpacingExtra="2dp"
                                android:maxLines="5"
                                android:ellipsize="end"
                                android:layout_marginBottom="4dp" />

                            <!-- More/Less Button -->
                            <TextView
                                android:id="@+id/btn_more_description"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="more"
                                android:textColor="#7A4F2B"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                android:layout_marginBottom="8dp" />

                            <!-- Contact Info with emoji -->
                            <TextView
                                android:id="@+id/post_contact"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📞 09123456789"
                                android:textColor="#666666"
                                android:textSize="14sp"
                                android:layout_marginTop="4dp"
                                android:visibility="visible" />

                            <!-- Location with emoji -->
                            <TextView
                                android:id="@+id/post_location"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📍 San Carlos, Pangasinan"
                                android:textColor="#666666"
                                android:textSize="14sp"
                                android:layout_marginTop="4dp"
                                android:visibility="visible" />
                        </LinearLayout>

                        <!-- RIGHT SIDE - Action Buttons Vertical (ALIGNED WITH GOLDEN RETRIEVER) -->
                        <LinearLayout
                            android:id="@+id/action_buttons_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_alignTop="@id/pet_info_container"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <!-- Like Button -->
                            <LinearLayout
                                android:id="@+id/btn_like"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:focusable="true"
                                android:layout_marginBottom="16dp">

                                <com.example.pawsociety.widget.LikeButton
                                    android:id="@+id/btn_like_lottie_view"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp" />

                                <TextView
                                    android:id="@+id/tv_like_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="124"
                                    android:textColor="#666666"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <!-- Message Button -->
                            <LinearLayout
                                android:id="@+id/btn_message"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:focusable="true"
                                android:layout_marginBottom="16dp"
                                android:visibility="visible">

                                <ImageView
                                    android:id="@+id/btn_message_icon"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/message"
                                    android:tint="#666666" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Chat"
                                    android:textColor="#666666"
                                    android:textSize="10sp"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <!-- Share Button -->
                            <LinearLayout
                                android:id="@+id/btn_share"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:focusable="true"
                                android:layout_marginBottom="16dp">

                                <ImageView
                                    android:id="@+id/btn_share_icon"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/share"
                                    android:tint="#666666" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Share"
                                    android:textColor="#666666"
                                    android:textSize="10sp"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <!-- Favorite Button -->
                            <LinearLayout
                                android:id="@+id/btn_favorite"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:focusable="true">

                                <ImageView
                                    android:id="@+id/btn_favorite_icon"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/faved"
                                    android:tint="#666666" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Save"
                                    android:textColor="#666666"
                                    android:textSize="10sp"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </RelativeLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>