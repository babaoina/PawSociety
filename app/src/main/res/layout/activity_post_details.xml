<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/back"
            android:tint="#000000"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Post"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_more"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="⋮"
            android:textColor="#000000"
            android:textSize="24sp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FAF0E6">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== POST CARD ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- ===== HEADER: User Info ===== -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:padding="8dp">

                        <!-- Profile Icon (text fallback) -->
                        <TextView
                            android:id="@+id/post_profile_icon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:gravity="center"
                            android:text="🐶"
                            android:textSize="20sp"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/circle_solid_profile"
                            android:visibility="visible" />

                        <!-- Profile Image (for users with actual image) -->
                        <ImageView
                            android:id="@+id/post_profile_image"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            android:background="@drawable/circle_border" />

                        <!-- Username and Location -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@id/post_profile_icon"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/post_user_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="username"
                                android:textColor="#000000"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/post_location"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Location"
                                android:textColor="#999999"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Time -->
                        <TextView
                            android:id="@+id/post_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="2h"
                            android:textColor="#999999"
                            android:textSize="11sp"
                            android:layout_marginEnd="8dp" />

                    </RelativeLayout>

                    <!-- ===== PET IMAGE CAROUSEL ===== -->
                    <FrameLayout
                        android:id="@+id/image_carousel_container"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:background="#F5F5F5">

                        <!-- ViewPager for multiple images -->
                        <androidx.viewpager2.widget.ViewPager2
                            android:id="@+id/post_view_pager"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                        <!-- Single Image (fallback) -->
                        <ImageView
                            android:id="@+id/post_image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="visible" />

                        <!-- Status Badge -->
                        <TextView
                            android:id="@+id/post_status"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_margin="12dp"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:text="LOST"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/status_badge_lost" />

                        <!-- Reward Badge (only for Lost posts) -->
                        <TextView
                            android:id="@+id/post_reward_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="12dp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="💰 ₱5,000"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="#80000000"
                            android:visibility="gone" />

                        <!-- Page Indicator -->
                        <TextView
                            android:id="@+id/page_indicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="16dp"
                            android:background="#80000000"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <!-- Image Indicators (dots) -->
                        <LinearLayout
                            android:id="@+id/indicator_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="8dp"
                            android:orientation="horizontal"
                            android:visibility="gone" />

                        <!-- Placeholder when no image -->
                        <LinearLayout
                            android:id="@+id/no_image_placeholder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:background="#F0F0F0">

                            <TextView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:gravity="center"
                                android:text="🐾"
                                android:textSize="40sp"
                                android:textColor="#CCCCCC" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="No image"
                                android:textColor="#999999"
                                android:textSize="14sp"
                                android:layout_marginTop="8dp" />
                        </LinearLayout>

                    </FrameLayout>

                    <!-- ===== PET INFO ===== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <!-- Pet Name and Type -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/post_pet_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Max"
                                android:textColor="#000000"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/post_pet_type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="• Shih Tzu"
                                android:textColor="#666666"
                                android:textSize="14sp"
                                android:layout_marginStart="6dp" />

                        </LinearLayout>

                        <!-- Description with "more" button -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/post_description"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Description of the pet goes here..."
                                android:textColor="#666666"
                                android:textSize="14sp"
                                android:maxLines="3"
                                android:ellipsize="end"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/btn_more_description"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="more"
                                android:textColor="#7A4F2B"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>

                        <!-- Contact Info -->
                        <TextView
                            android:id="@+id/post_contact"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📞 09123456789"
                            android:textColor="#666666"
                            android:textSize="13sp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="2dp"
                            android:gravity="start" />

                        <!-- Reward Text -->
                        <TextView
                            android:id="@+id/post_reward"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💰 ₱5,000"
                            android:textColor="#7A4F2B"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"
                            android:visibility="gone" />

                        <!-- ===== ACTION BUTTONS (NO COMMENT BUTTON) ===== -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp">

                            <!-- Like Button -->
                            <LinearLayout
                                android:id="@+id/btn_like"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:paddingEnd="16dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:background="?android:attr/selectableItemBackgroundBorderless">

                                <ImageView
                                    android:id="@+id/btn_like_icon"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:src="@drawable/heart"
                                    android:tint="#666666" />

                                <TextView
                                    android:id="@+id/tv_like_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="#666666"
                                    android:textSize="12sp"
                                    android:layout_marginStart="4dp" />
                            </LinearLayout>

                            <!-- Share Button -->
                            <LinearLayout
                                android:id="@+id/btn_share"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:paddingEnd="16dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:background="?android:attr/selectableItemBackgroundBorderless">

                                <ImageView
                                    android:id="@+id/btn_share_icon"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:src="@drawable/share"
                                    android:tint="#666666" />
                            </LinearLayout>

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <!-- Favorite Button -->
                            <LinearLayout
                                android:id="@+id/btn_favorite"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:paddingEnd="16dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:background="?android:attr/selectableItemBackgroundBorderless">

                                <ImageView
                                    android:id="@+id/btn_favorite_icon"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:src="@drawable/faved"
                                    android:tint="#666666" />
                            </LinearLayout>

                        </LinearLayout>

                        <!-- CHAT BUTTON - Added below action buttons -->
                        <Button
                            android:id="@+id/btn_chat"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="8dp"
                            android:text="Chat with Owner"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:background="@drawable/button_oval_brown"
                            android:visibility="visible" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ===== COMMENTS SECTION ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:layout_margin="8dp"
                android:layout_marginTop="0dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Comments"
                    android:textColor="#7A4F2B"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ProgressBar
                        android:id="@+id/progress_bar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/comments_recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="100dp"
                        android:nestedScrollingEnabled="false" />
                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Comment Input (always at bottom) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <EditText
            android:id="@+id/comment_input"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Add a comment..."
            android:textColorHint="#999999"
            android:textSize="14sp"
            android:background="@drawable/input_oval"
            android:paddingHorizontal="16dp"
            android:maxLines="3"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/btn_post_comment"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/send1"
            android:background="@drawable/circle_solid_profile"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>