<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filter and Sort"
            android:textColor="#7A4F2B"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Sort By Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sort By"
            android:textColor="#7A4F2B"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <RadioGroup
            android:id="@+id/rg_sort_by"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rb_newest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Newest First"
                android:textColor="#000000"
                android:textSize="16sp"
                android:checked="true"
                android:paddingVertical="8dp" />

            <RadioButton
                android:id="@+id/rb_oldest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oldest First"
                android:textColor="#000000"
                android:textSize="16sp"
                android:paddingVertical="8dp" />

            <RadioButton
                android:id="@+id/rb_most_liked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Most Liked"
                android:textColor="#000000"
                android:textSize="16sp"
                android:paddingVertical="8dp" />
        </RadioGroup>

        <!-- Time Range Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Time Range"
            android:textColor="#7A4F2B"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <RadioGroup
            android:id="@+id/rg_time_range"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rb_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textColor="#000000"
                android:textSize="16sp"
                android:paddingVertical="8dp" />

            <RadioButton
                android:id="@+id/rb_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This Week"
                android:textColor="#000000"
                android:textSize="16sp"
                android:paddingVertical="8dp" />

            <RadioButton
                android:id="@+id/rb_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This Month"
                android:textColor="#000000"
                android:textSize="16sp"
                android:paddingVertical="8dp" />

            <RadioButton
                android:id="@+id/rb_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Time"
                android:textColor="#000000"
                android:textSize="16sp"
                android:checked="true"
                android:paddingVertical="8dp" />
        </RadioGroup>

        <!-- Location Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Location"
            android:textColor="#7A4F2B"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_location"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Enter city or region"
            android:textColorHint="#999999"
            android:textColor="#000000"
            android:textSize="14sp"
            android:padding="12dp"
            android:background="@drawable/edittext_bg"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_nearby"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Use My Location"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/button_oval_brown"
            android:layout_marginBottom="24dp" />

        <!-- Action Buttons - FIXED Cancel Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:weightSum="2">

            <!-- Cancel Button - WHITE with gray border -->
            <Button
                android:id="@+id/btn_cancel_filter"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Cancel"
                android:textColor="#666666"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/button_oval_white_solid"
                android:stateListAnimator="@null" />

            <!-- Apply Button - BROWN -->
            <Button
                android:id="@+id/btn_apply_filter"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Apply"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/button_oval_brown"
                android:stateListAnimator="@null" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>