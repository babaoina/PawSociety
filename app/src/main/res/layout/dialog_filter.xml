<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:background="@drawable/bg_find_filter_sheet"
        android:elevation="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filter and Sort"
            android:textColor="#7A4F2B"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="18dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_find_filter_section"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sort By"
                android:textColor="#7A4F2B"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <RadioGroup
                android:id="@+id/rg_sort_by"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rb_newest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Newest First"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:checked="true"
                    android:buttonTint="#8A5A30"
                    android:paddingVertical="8dp" />

                <RadioButton
                    android:id="@+id/rb_oldest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oldest First"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:buttonTint="#8A5A30"
                    android:paddingVertical="8dp" />

                <RadioButton
                    android:id="@+id/rb_most_liked"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Most Liked"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:buttonTint="#8A5A30"
                    android:paddingVertical="8dp" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_find_filter_section"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time Range"
                android:textColor="#7A4F2B"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <RadioGroup
                android:id="@+id/rg_time_range"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rb_today"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:buttonTint="#8A5A30"
                    android:paddingVertical="8dp" />

                <RadioButton
                    android:id="@+id/rb_week"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="This Week"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:buttonTint="#8A5A30"
                    android:paddingVertical="8dp" />

                <RadioButton
                    android:id="@+id/rb_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="This Month"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:buttonTint="#8A5A30"
                    android:paddingVertical="8dp" />

                <RadioButton
                    android:id="@+id/rb_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All Time"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:checked="true"
                    android:buttonTint="#8A5A30"
                    android:paddingVertical="8dp" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_find_filter_section"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textColor="#7A4F2B"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_location"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Enter city or region"
                android:textColorHint="#9B8A7A"
                android:textColor="#000000"
                android:textSize="14sp"
                android:padding="12dp"
                android:background="@drawable/bg_find_search_surface" />
        </LinearLayout>

        <!-- Action Buttons - FIXED Cancel Button with better visibility -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:weightSum="2">

            <!-- Cancel Button - WHITE background with brown TEXT -->
            <Button
                android:id="@+id/btn_cancel_filter"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Cancel"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_find_filter_cancel"
                android:stateListAnimator="@null" />

            <!-- Apply Button - BROWN -->
            <Button
                android:id="@+id/btn_apply_filter"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Apply"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_find_filter_apply"
                android:stateListAnimator="@null" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
