<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_rounded_dialog">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Update Email"
        android:textColor="#7A4F2B"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"
        android:layout_gravity="center_horizontal" />

    <!-- Current Email Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current Email Address"
        android:textColor="#666666"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="8dp" />

    <!-- Current Email (read-only) -->
    <TextView
        android:id="@+id/tv_current_email"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_rounded_edittext_readonly"
        android:textColor="#333333"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <!-- New Email Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Email Address"
        android:textColor="#666666"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="8dp" />

    <!-- New Email Input -->
    <EditText
        android:id="@+id/et_new_email"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Enter new email address"
        android:inputType="textEmailAddress"
        android:textColor="#000000"
        android:textColorHint="#999999"
        android:background="@drawable/bg_rounded_edittext"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp" />

    <!-- Password Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirm Password"
        android:textColor="#666666"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="8dp" />

    <!-- Password Input -->
    <EditText
        android:id="@+id/et_password"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Enter your password"
        android:inputType="textPassword"
        android:textColor="#000000"
        android:textColorHint="#999999"
        android:background="@drawable/bg_rounded_edittext"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="24dp" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:indeterminate="true"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <!-- Button Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:weightSum="2">

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:text="Cancel"
            android:textColor="#666666"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_rounded_button_white"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_update"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="Update"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_rounded_button_brown"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>