<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- Profile Image Container - CIRCULAR with online dot -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="12dp">

        <!-- Text Icon (when no image) -->
        <TextView
            android:id="@+id/tv_profile_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/circle_solid_profile"
            android:visibility="visible" />

        <!-- Image Icon (when image exists) - CIRCULAR -->
        <ImageView
            android:id="@+id/iv_profile"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:background="@drawable/circle_border" />

        <!-- Online Indicator (Green Dot) -->
        <View
            android:id="@+id/online_indicator"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/online_indicator"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Content Container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_gravity="center_vertical">

        <!-- Username and Time Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="username"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_alignParentStart="true" />

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2h"
                android:textColor="#999999"
                android:textSize="11sp"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>

        <!-- Last Message -->
        <TextView
            android:id="@+id/tv_last_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Last message"
            android:textColor="#666666"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <!-- Request Badge (for requests tab) -->
        <TextView
            android:id="@+id/request_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REQUEST"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/request_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <!-- Accept/Reject Buttons (for requests tab) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_accept"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Accept"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="@drawable/button_oval_green"
                android:visibility="visible" />

            <Button
                android:id="@+id/btn_reject"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Reject"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="@drawable/button_oval_red"
                android:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <!-- Unread Count Badge -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp">

        <View
            android:id="@+id/red_ping"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/red_ping"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_unread"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:gravity="center"
            android:text="99"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/circle_solid_red"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>