<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_rounded_dialog"
    android:padding="20dp">

    <!-- Title - only ONE title now -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Select Location"
        android:textColor="#7A4F2B"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <!-- Region -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Region"
        android:textColor="#666666"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinner_region"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/input_oval"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="16dp" />

    <!-- Province -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Province"
        android:textColor="#666666"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinner_province"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/input_oval"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="16dp" />

    <!-- City -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="City/Municipality"
        android:textColor="#666666"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinner_city"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/input_oval"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="16dp" />

    <!-- Barangay -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Barangay"
        android:textColor="#666666"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinner_barangay"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/input_oval"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="24dp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:weightSum="2">

        <!-- Cancel button - WHITE TEXT -->
        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Cancel"
            android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:background="@drawable/button_oval_gray"
        android:stateListAnimator="@null" />

        <!-- Confirm button -->
        <Button
            android:id="@+id/btn_confirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Confirm"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:background="@drawable/button_oval_brown"
            android:stateListAnimator="@null" />
    </LinearLayout>

</LinearLayout>