<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/paws1">

    <!-- Top Bar - PURE WHITE (not affected by bg) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Find Pets"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Removed settings emoji -->

    </LinearLayout>

    <!-- Search Bar and Filter Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@android:color/transparent">

        <!-- Search Input Field (oval background) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical"
            android:background="@drawable/input_oval"
            android:layout_marginEnd="12dp">

            <!-- Magnifying glass PNG -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/find"
                android:tint="#7A4F2B" />

            <EditText
                android:id="@+id/search_input"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Search pets, breeds, locations..."
                android:textColorHint="#666666"
                android:textColor="#000000"
                android:textSize="14sp"
                android:background="@null"
                android:layout_marginStart="8dp"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Filter Button (oval background) -->
        <LinearLayout
            android:id="@+id/btn_filter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/input_oval"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp">

            <!-- Filter PNG -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/filter"
                android:tint="#7A4F2B" />
        </LinearLayout>
    </LinearLayout>

    <!-- Filter Chips - Using colored oval backgrounds -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:scrollbars="none"
        android:background="@android:color/transparent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- All Pets - Brown oval -->
            <TextView
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="All Pets"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="20dp"
                android:background="@drawable/button_oval_brown"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Lost - Red oval -->
            <TextView
                android:id="@+id/chip_lost"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="Lost"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="20dp"
                android:background="@drawable/button_oval_red"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Found - Green oval -->
            <TextView
                android:id="@+id/chip_found"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="Found"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="20dp"
                android:background="@drawable/button_oval_green"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- For Adoption - Blue oval -->
            <TextView
                android:id="@+id/chip_adoption"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="Adoption"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="20dp"
                android:background="@drawable/button_oval_blue"
                android:clickable="true"
                android:focusable="true"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Grid of Pet Pictures -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/find_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="2dp"
        android:clipToPadding="false" />

    <!-- Empty State (transparent so bg shows through) -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="32dp"
        android:background="@android:color/transparent">

        <TextView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:gravity="center"
            android:text="🐾"
            android:textSize="60sp"
            android:background="@drawable/input_oval"
            android:backgroundTint="#80FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No pets found"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check back later for new posts!"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Bottom Navigation (semi-transparent) -->
    <include
        layout="@layout/bottom_nav_unified"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>