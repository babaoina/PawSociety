<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Background Image -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/paws1"
            android:scaleType="centerCrop"
            android:contentDescription="Background" />

        <!-- Semi-transparent overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80FFFFFF" />

        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="#7A4F2B"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical"
                android:elevation="4dp">

                <TextView
                    android:id="@+id/btn_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cancel"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New Post"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btn_post"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Post"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Photo Upload Area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_rounded"
                android:layout_margin="16dp"
                android:elevation="4dp"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Photos"
                    android:textColor="#7A4F2B"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Image Preview Container -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/image_preview_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="4dp" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/btn_add_photo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Photos (Optional)"
                    android:textColor="#7A4F2B"
                    android:textSize="14sp"
                    android:layout_marginTop="12dp"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackground" />

                <TextView
                    android:id="@+id/tv_photo_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/5"
                    android:textColor="#B88B4A"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Form - White card with rounded corners -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/card_rounded"
                android:layout_margin="16dp"
                android:layout_marginTop="0dp"
                android:elevation="4dp"
                android:id="@+id/form_container">

                <!-- Pet Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pet Name"
                    android:textColor="#7A4F2B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_pet_name"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Enter pet name (max 10 chars)"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/input_oval"
                    android:layout_marginBottom="16dp"
                    android:maxLength="10"
                    android:imeOptions="actionNext"
                    android:textSize="14sp" />

                <!-- Pet Type/Breed -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Type/Breed"
                    android:textColor="#7A4F2B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"
                    android:layout_marginTop="8dp" />

                <AutoCompleteTextView
                    android:id="@+id/act_pet_type"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Start typing breed (e.g., Aspin, Shih Tzu)"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/input_oval"
                    android:layout_marginBottom="16dp"
                    android:completionThreshold="1"
                    android:dropDownWidth="match_parent"
                    android:dropDownVerticalOffset="4dp"
                    android:popupBackground="#FFFFFF"
                    android:imeOptions="actionNext"
                    android:textSize="14sp" />

                <!-- Status -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status"
                    android:textColor="#7A4F2B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:id="@+id/status_buttons_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/btn_status_lost"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:text="Lost"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_oval_red"
                        android:clickable="true"
                        android:focusable="true"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_status_found"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:text="Found"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_oval_green"
                        android:clickable="true"
                        android:focusable="true"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_status_adoption"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Adoption"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_oval_blue"
                        android:clickable="true"
                        android:focusable="true"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Reward/Price -->
                <LinearLayout
                    android:id="@+id/layout_reward"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reward/Price"
                        android:textColor="#7A4F2B"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/et_reward"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Enter amount (e.g., ₱1000)"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/input_oval"
                        android:layout_marginBottom="16dp"
                        android:maxLength="20"
                        android:imeOptions="actionNext"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Location -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Location"
                    android:textColor="#7A4F2B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <Button
                    android:id="@+id/btn_select_location"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Select Location"
                    android:textColor="#7A4F2B"
                    android:background="@drawable/input_oval"
                    android:gravity="center|start"
                    android:paddingLeft="16dp"
                    android:layout_marginBottom="16dp"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:textColor="#7A4F2B"
                    android:textSize="14sp"
                    android:text="No location selected"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <!-- Contact -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contact Number"
                    android:textColor="#7A4F2B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_contact"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="09123456789"
                    android:inputType="phone"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/input_oval"
                    android:layout_marginBottom="8dp"
                    android:maxLength="11"
                    android:digits="0123456789"
                    android:imeOptions="actionNext"
                    android:textSize="14sp" />

                <!-- Phone hint -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="11 digits starting with 09"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginStart="4dp" />

                <!-- Description -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Description"
                    android:textColor="#7A4F2B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_description"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:hint="Tell us about this pet... (min. 10 characters)"
                    android:inputType="textMultiLine"
                    android:gravity="top|start"
                    android:padding="16dp"
                    android:background="@drawable/input_oval"
                    android:layout_marginBottom="8dp"
                    android:maxLength="500"
                    android:imeOptions="actionDone"
                    android:textSize="14sp" />

                <!-- Character counter hint -->
                <TextView
                    android:id="@+id/tv_char_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/500 characters"
                    android:textColor="#999999"
                    android:textSize="11sp"
                    android:layout_marginBottom="8dp"
                    android:layout_gravity="end" />
            </LinearLayout>

            <!-- Bottom spacing -->
            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>