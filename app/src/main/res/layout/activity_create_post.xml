<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Background Image -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/paws1"
            android:scaleType="centerCrop"
            android:contentDescription="Background" />

        <!-- Semi-transparent overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80FFFFFF" />

        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="#7A4F2B"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical"
                android:elevation="4dp">

                <TextView
                    android:id="@+id/btn_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cancel"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New Post"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btn_post"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Post"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ========== PHOTO UPLOAD AREA ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_rounded"
                android:layout_margin="16dp"
                android:elevation="4dp"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Photos"
                    android:textColor="#7A4F2B"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Photo Count and Add Button Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tv_photo_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0/5 photos"
                        android:textColor="#7A4F2B"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_add_photo"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:paddingHorizontal="16dp"
                        android:gravity="center"
                        android:text="+ Add Photo"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/button_oval_brown"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Horizontal ScrollView for photo thumbnails -->
                <HorizontalScrollView
                    android:id="@+id/thumbnail_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/thumbnail_container"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="4dp" />
                </HorizontalScrollView>

                <!-- CAROUSEL VIEW for photos -->
                <FrameLayout
                    android:id="@+id/carousel_container"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="#F0F0F0"
                    android:visibility="gone">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/photo_view_pager"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <ImageView
                        android:id="@+id/btn_remove_current_photo"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="8dp"
                        android:src="@drawable/close_circle"
                        android:tint="#F44336"
                        android:background="@drawable/circle_solid_white"
                        android:padding="8dp"
                        android:elevation="4dp"
                        android:visibility="gone"
                        android:contentDescription="Remove photo" />

                    <LinearLayout
                        android:id="@+id/photo_indicator_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/photo_empty_state"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="#F8F8F8">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/camera"
                            android:tint="#CCCCCC" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No photos added"
                            android:textColor="#999999"
                            android:textSize="14sp"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap + Add Photo to upload"
                            android:textColor="#B88B4A"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </FrameLayout>

                <ProgressBar
                    android:id="@+id/photo_upload_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:layout_marginTop="8dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:id="@+id/image_preview_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="4dp" />
                </HorizontalScrollView>

            </LinearLayout>

            <!-- Form -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/card_rounded"
                android:layout_margin="16dp"
                android:layout_marginTop="0dp"
                android:elevation="4dp"
                android:id="@+id/form_container">

                <!-- Pet Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pet Name"
                    android:textColor="#7A4F2B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_pet_name"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Enter pet name (max 10 chars)"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/input_oval"
                    android:layout_marginBottom="16dp"
                    android:maxLength="10"
                    android:imeOptions="actionNext"
                    android:textSize="14sp" />

                <!-- SELECT TYPE (Category Selector) with Images -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Type"
                    android:textColor="#7A4F2B"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/layout_category_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="4"
                    android:gravity="center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:visibility="visible">

                    <!-- Dogs Category -->
                    <LinearLayout
                        android:id="@+id/layout_category_dogs"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:id="@+id/iv_category_dogs"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/dog"
                            android:tint="#7A4F2B" />

                        <TextView
                            android:id="@+id/tv_category_dogs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dogs"
                            android:textColor="#7A4F2B"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Cats Category -->
                    <LinearLayout
                        android:id="@+id/layout_category_cats"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:id="@+id/iv_category_cats"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/cat"
                            android:tint="#7A4F2B" />

                        <TextView
                            android:id="@+id/tv_category_cats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cats"
                            android:textColor="#7A4F2B"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Fish Category -->
                    <LinearLayout
                        android:id="@+id/layout_category_fish"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:id="@+id/iv_category_fish"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/fish"
                            android:tint="#7A4F2B" />

                        <TextView
                            android:id="@+id/tv_category_fish"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fish"
                            android:textColor="#7A4F2B"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Birds Category -->
                    <LinearLayout
                        android:id="@+id/layout_category_birds"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:id="@+id/iv_category_birds"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/bird"
                            android:tint="#7A4F2B" />

                        <TextView
                            android:id="@+id/tv_category_birds"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Birds"
                            android:textColor="#7A4F2B"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Breed Selector (appears after category selection) - REDESIGNED -->
                <LinearLayout
                    android:id="@+id/layout_breed_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:background="@drawable/card_rounded"
                    android:padding="16dp"
                    android:layout_marginTop="8dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <!-- Cooler back button with icon -->
                        <ImageView
                            android:id="@+id/btn_back_to_categories"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_back_arrow"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:padding="8dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/tv_selected_category"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="What breed?"
                            android:textColor="#7A4F2B"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <!-- Breed Input (searchable) with icon -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Breed"
                        android:textColor="#7A4F2B"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <AutoCompleteTextView
                        android:id="@+id/act_pet_type"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="e.g., Aspin, Labrador, Persian..."
                        android:paddingHorizontal="16dp"
                        android:paddingStart="40dp"
                        android:background="@drawable/input_oval"
                        android:drawableStart="@drawable/ic_search"
                        android:drawablePadding="8dp"
                        android:layout_marginBottom="8dp"
                        android:completionThreshold="1"
                        android:dropDownWidth="match_parent"
                        android:dropDownVerticalOffset="4dp"
                        android:popupBackground="#FFFFFF"
                        android:imeOptions="actionNext"
                        android:textSize="14sp" />

                    <!-- Breed suggestions hint -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Start typing to see suggestions"
                        android:textColor="#999999"
                        android:textSize="12sp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <!-- Status -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status"
                    android:textColor="#7A4F2B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:id="@+id/status_buttons_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/btn_status_lost"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:text="Lost"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_oval_red"
                        android:clickable="true"
                        android:focusable="true"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_status_found"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:text="Found"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_oval_green"
                        android:clickable="true"
                        android:focusable="true"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_status_adoption"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Adoption"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_oval_blue"
                        android:clickable="true"
                        android:focusable="true"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- GENDER SELECTION -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gender"
                    android:textColor="#7A4F2B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/btn_gender_male"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:text="Male"
                        android:textColor="#666666"
                        android:background="@drawable/button_oval_white"
                        android:clickable="true"
                        android:focusable="true"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_gender_female"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:text="Female"
                        android:textColor="#666666"
                        android:background="@drawable/button_oval_white"
                        android:clickable="true"
                        android:focusable="true"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_gender_unknown"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Unknown"
                        android:textColor="#666666"
                        android:background="@drawable/button_oval_white"
                        android:clickable="true"
                        android:focusable="true"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Age -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Age"
                    android:textColor="#7A4F2B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_age"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="e.g., 2 years, 8 months"
                    android:inputType="text"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/input_oval"
                    android:layout_marginBottom="16dp"
                    android:textSize="14sp" />

                <!-- Weight -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weight"
                    android:textColor="#7A4F2B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_weight"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="e.g., 3.5kg, 10 lbs"
                    android:inputType="text"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/input_oval"
                    android:layout_marginBottom="16dp"
                    android:textSize="14sp" />

                <!-- Reward/Price -->
                <LinearLayout
                    android:id="@+id/layout_reward"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reward/Price"
                        android:textColor="#7A4F2B"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/et_reward"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Enter amount (e.g., ₱1000)"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/input_oval"
                        android:layout_marginBottom="16dp"
                        android:maxLength="20"
                        android:imeOptions="actionNext"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Location - REDESIGNED with better visibility -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Location"
                    android:textColor="#7A4F2B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <Button
                    android:id="@+id/btn_select_location"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="  Select Location"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center|start"
                    android:drawableStart="@drawable/ic_location"
                    android:drawablePadding="8dp"
                    android:background="@drawable/button_oval_brown_outline"
                    android:paddingLeft="16dp"
                    android:layout_marginBottom="16dp"
                    android:elevation="2dp" />

                <TextView
                    android:id="@+id/tv_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:textColor="#7A4F2B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/location_selected_bg"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <!-- Contact -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contact Number"
                    android:textColor="#7A4F2B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_contact"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="09123456789"
                    android:inputType="phone"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/input_oval"
                    android:layout_marginBottom="8dp"
                    android:maxLength="11"
                    android:digits="0123456789"
                    android:imeOptions="actionNext"
                    android:textSize="14sp" />

                <!-- Phone hint -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="11 digits starting with 09"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginStart="4dp" />

                <!-- Description -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Description"
                    android:textColor="#7A4F2B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_description"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:hint="Tell us about this pet... (min. 10 characters)"
                    android:inputType="textMultiLine"
                    android:gravity="top|start"
                    android:padding="16dp"
                    android:background="@drawable/input_oval"
                    android:layout_marginBottom="8dp"
                    android:maxLength="500"
                    android:imeOptions="actionDone"
                    android:textSize="14sp" />

                <!-- Character counter hint -->
                <TextView
                    android:id="@+id/tv_char_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/500 characters"
                    android:textColor="#999999"
                    android:textSize="11sp"
                    android:layout_marginBottom="8dp"
                    android:layout_gravity="end" />
            </LinearLayout>

            <!-- Bottom spacing -->
            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />
