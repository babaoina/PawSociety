<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.PawSociety" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">#7A4F2B</item>
        <item name="colorPrimaryVariant">#B88B4A</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">#2196F3</item>
        <item name="colorSecondaryVariant">#1976D2</item>
        <item name="colorOnSecondary">@android:color/white</item>

        <!-- Status bar color - TRANSPARENT for full screen -->
        <item name="android:statusBarColor">@android:color/transparent</item>

        <!-- Navigation bar color - TRANSPARENT for full screen -->
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Make status bar icons dark (for light backgrounds) -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Full screen settings -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>

        <!-- Background colors -->
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorBackground">@android:color/white</item>

        <!-- ===== TEXT COLORS FOR ALL SCREENS ===== -->
        <!-- Default text color -->
        <item name="android:textColor">#000000</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#666666</item>
        <item name="android:textColorHint">#999999</item>

        <!-- EditText specific colors -->
        <item name="android:editTextColor">#000000</item>
        <item name="android:editTextStyle">@style/Widget.PawSociety.EditText</item>

        <!-- TextView colors -->
        <item name="android:textColorLink">#7A4F2B</item>
        <item name="android:textColorHighlight">#F5E6D3</item>

        <!-- Force simple light popups across the app -->
        <item name="alertDialogTheme">@style/Theme.PawSociety.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.PawSociety.MaterialAlertDialog</item>
        <item name="android:alertDialogTheme">@style/Theme.PawSociety.Dialog</item>
        <item name="android:datePickerDialogTheme">@style/Theme.PawSociety.DatePickerDialog</item>
    </style>

    <!-- Custom EditText style -->
    <style name="Widget.PawSociety.EditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">#000000</item>
        <item name="android:textColorHint">#999999</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">12dp</item>
    </style>

    <!-- Home Activity Theme (with brown background) -->
    <style name="Theme.PawSociety.Home" parent="Theme.PawSociety">
        <item name="android:windowBackground">#D2B48C</item>
        <item name="android:colorBackground">#D2B48C</item>
    </style>

    <!-- Dialog theme for alerts -->
    <style name="Theme.PawSociety.Dialog" parent="Theme.MaterialComponents.Light.Dialog">
        <!-- Make dialog background white -->
        <item name="android:background">@android:color/white</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorBackground">@android:color/white</item>

        <!-- Text colors -->
        <item name="android:textColor">#000000</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#666666</item>

        <!-- Title text color -->
        <item name="android:windowTitleStyle">@style/DialogTitleStyle</item>

        <!-- Button colors -->
        <item name="colorPrimary">#7A4F2B</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- EditText styling -->
        <item name="editTextStyle">@style/Widget.PawSociety.EditText</item>

        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/Widget.PawSociety.DialogButton.Positive</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Widget.PawSociety.DialogButton.Negative</item>
        <item name="android:datePickerStyle">@style/Widget.PawSociety.DatePicker</item>
    </style>

    <style name="ThemeOverlay.PawSociety.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="backgroundTint">@android:color/white</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="colorOnSurface">#1F1F1F</item>
        <item name="colorPrimary">#7A4F2B</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.PawSociety.DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.PawSociety.DialogButton.Negative</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.PawSociety.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.PawSociety.DialogBody</item>
    </style>

    <style name="Theme.PawSociety.DatePickerDialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:background">@android:color/white</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="colorOnSurface">#1F1F1F</item>
        <item name="colorPrimary">#7A4F2B</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:datePickerStyle">@style/Widget.PawSociety.DatePicker</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/Widget.PawSociety.DialogButton.Positive</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Widget.PawSociety.DialogButton.Negative</item>
    </style>

    <!-- Dialog title style -->
    <style name="DialogTitleStyle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.PawSociety.DialogTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">#1F1F1F</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.PawSociety.DialogBody" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">#4A4A4A</item>
    </style>

    <style name="Widget.PawSociety.DialogButton.Positive" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">#7A4F2B</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.PawSociety.DialogButton.Negative" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">#666666</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.PawSociety.DatePicker" parent="@android:style/Widget.Material.DatePicker">
        <item name="android:calendarTextColor">#1F1F1F</item>
        <item name="android:headerBackground">#7A4F2B</item>
        <item name="android:dayOfWeekTextAppearance">@style/TextAppearance.PawSociety.DatePicker.DayOfWeek</item>
        <item name="android:yearListItemTextAppearance">@style/TextAppearance.PawSociety.DatePicker.Day</item>
    </style>

    <style name="TextAppearance.PawSociety.DatePicker.DayOfWeek" parent="@android:style/TextAppearance.Material.Body2">
        <item name="android:textColor">#7A4F2B</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.PawSociety.DatePicker.Day" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">#1F1F1F</item>
    </style>

    <style name="BottomMenuAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_up_menu</item>
        <item name="android:windowExitAnimation">@anim/slide_out_down_menu</item>
    </style>

    <!-- ===== UCROP FULLSCREEN THEME ===== -->
    <style name="Theme.PawSociety.UCrop" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Fullscreen settings -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>

        <!-- Background -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>

        <!-- Transparent bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>

        <!-- Status bar icons light (white) for dark background -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- UCrop toolbar colors -->
        <item name="android:toolbarStyle">@style/UCropToolbarStyle</item>
    </style>

    <!-- UCrop Toolbar Style -->
    <style name="UCropToolbarStyle" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">#7A4F2B</item>
        <item name="android:minHeight">56dp</item>
        <item name="titleTextColor">@android:color/white</item>
        <item name="android:titleTextColor">@android:color/white</item>
        <item name="android:elevation">4dp</item>
    </style>

</resources>
